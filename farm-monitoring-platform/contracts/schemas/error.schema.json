{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorResponse",
  "type": "object",
  "required": ["success", "error", "traceId"],
  "properties": {
    "success": { "const": false },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string" },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["message"],
            "properties": { "field": { "type": "string" }, "message": { "type": "string" } }
          }
        }
      }
    },
    "traceId": { "type": "string" }
  }
}
