# SQL Server (local)
SA_PASSWORD=Your_Str0ng_Passw0rd!

# JWT (khóa nằm trong ./keys, sinh bằng scripts/gen-jwt-keys.sh)
JWT_ISSUER=farm-auth
JWT_AUDIENCE=farm-api
JWT_ACCESS_MINUTES=30

# Địa chỉ nội bộ giữa các service (trong mạng docker)
USER_AUTH_URL=http://user-auth:8080
FARM_DEVICE_URL=http://farm-device:8080
MISSION_URL=http://mission:8080
SENSOR_DATA_URL=http://sensor-data:8080
ALERT_URL=http://alert:8080
NOTIFICATION_URL=http://notification:8080
