# SQL Server (local)
MSSQL_SA_PASSWORD=FarmMonitoring@

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

REDIS_PASSWORD=farmmonitoring

# JWT (khóa nằm trong ./keys, sinh bằng scripts/gen-jwt-keys.sh)
JWT_ISSUER=farm-auth
JWT_AUDIENCE=farm-api
JWT_ACCESS_MINUTES=30

UAV_CLIENT_ID=uav-simulator-01
UAV_CLIENT_SECRET=your-client-secret

# Địa chỉ nội bộ giữa các service (trong mạng docker)
USER_AUTH_URL=http://user-auth:8080
FARM_DEVICE_URL=http://farm-device:8080
MISSION_URL=http://mission:8080
SENSOR_DATA_URL=http://sensor-data:8080
ALERT_URL=http://alert:8080
NOTIFICATION_URL=http://notification:8080

# Notification Service (điền cấu hình của từng dev trong deploy/.env)
# UUID tài khoản admin nhận thông báo web
NOTIFICATION_ADMIN_ID=
# Địa chỉ hộp thư nhận cảnh báo khi bật email
NOTIFICATION_ADMIN_EMAIL=
NOTIFICATION_EMAIL_ENABLED=false

# SMTP (điền theo nhà cung cấp khi bật email)
# Port 587 với SSL=true dùng STARTTLS
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SSL=true
NOTIFICATION_SMTP_FROM=
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
