{
  "CoreAppSetting": {
    "ConnectionStringSetting": {
      "UserAuthService": "Server=MSI;Database=user-auth-db;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
    },
    "Jwt": {
      "Issuer": "farm-auth",
      "Audience": "farm-api",
      "ExpireTime": 10080, //minute (10080 = 7 ngày)
      "ServiceTokenExpireTime": 15, //minute
      "PrivateKeyPath": "keys/jwt-private.pem"
    },
    "Seed": {
      "Enabled": false,
      "AdminEmail": "admin@farm.vn",
      "AdminPassword": ""
    },
    "ServiceClients": [
      {
        "ClientId": "api-gateway",
        "Secret": ""
      },
      {
        "ClientId": "farm-device-service",
        "Secret": ""
      },
      {
        "ClientId": "mission-service",
        "Secret": ""
      },
      {
        "ClientId": "sensor-data-service",
        "Secret": ""
      },
      {
        "ClientId": "alert-service",
        "Secret": ""
      },
      {
        "ClientId": "notification-service",
        "Secret": ""
      }
    ],
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
