{
  "CoreAppSetting": {
    "ConnectionStringSetting": {
      "UserAuthService": "Server=MSI;Database=user_auth_db;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"
    },
    "Jwt": {
      "Issuer": "farm-auth",
      "Audience": "farm-api",
      "ExpireTime": 30,
      "RefreshTokenExpireDays": 7,
      "ServiceTokenExpireTime": 15, //minute
      "PrivateKeyPath": "keys/jwt-private.pem"
    },
    "Seed": {
      "Enabled": true,
      "AdminEmail": "admin@farm.vn",
      "AdminPassword": "Admin@123456"
    },
    "ServiceClients": [
      {
        "ClientId": "api-gateway",
        "Secret": "dev-secret-api-gateway"
      },
      {
        "ClientId": "farm-device-service",
        "Secret": "dev-secret-farm-device"
      },
      {
        "ClientId": "mission-service",
        "Secret": "dev-secret-mission"
      },
      {
        "ClientId": "sensor-data-service",
        "Secret": "dev-secret-sensor-data"
      },
      {
        "ClientId": "alert-service",
        "Secret": "dev-secret-alert"
      },
      {
        "ClientId": "notification-service",
        "Secret": "dev-secret-notification"
      }
    ],
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
