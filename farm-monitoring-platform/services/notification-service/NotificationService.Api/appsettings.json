{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Queue": "notification.events"
  },
  "Notifications": {
    "RecipientSource": "Configuration",
    "MissionSource": "Direct",
    "Recipients": []
  },
  "UserAuth": {
    "BaseUrl": "http://user-auth-service:8080/",
    "ClientId": "notification-service",
    "RecipientsPath": "internal/v1/users/notification-recipients"
  },
  "Email": {
    "Enabled": false,
    "Port": 587,
    "EnableSsl": true,
    "MaxAttempts": 5,
    "RetrySeconds": 10
  },
  "Jwt": {
    "Issuer": "farm-auth",
    "Audience": "farm-api",
    "MetadataAddress": "http://user-auth-service:8080/.well-known/openid-configuration"
  }
}
