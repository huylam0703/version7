{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AUTH_METADATA_URI": "http://localhost:5001/.well-known/openid-configuration",

  "Gateway": {
    "Auth": { "Enabled": true },
    "Cors": { "Origins": [ "http://localhost:3000", "http://localhost:5173" ] },
    "RateLimit": { "PermitPerMinute": 120 }
  },

  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "user-auth",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/auth/{**rest}" }
      },
      "users": {
        "ClusterId": "user-auth",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/users/{**rest}" }
      },
      "farms": {
        "ClusterId": "farm-device",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/farms/{**rest}" }
      },
      "missions": {
        "ClusterId": "mission",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/missions/{**rest}" }
      },
      "sensors": {
        "ClusterId": "sensor-data",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/sensor/{**rest}" }
      },
      "alerts": {
        "ClusterId": "alert",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/alerts/{**rest}" }
      },
      "notifications": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/notifications/{**rest}" }
      }
    },
    "Clusters": {
      "user-auth": { "Destinations": { "d1": { "Address": "http://localhost:5001/" } } },
      "farm-device": { "Destinations": { "d1": { "Address": "http://localhost:5002/" } } },
      "mission": { "Destinations": { "d1": { "Address": "http://localhost:5003/" } } },
      "sensor-data": { "Destinations": { "d1": { "Address": "http://localhost:5004/" } } },
      "alert": { "Destinations": { "d1": { "Address": "http://localhost:5005/" } } },
      "notification": { "Destinations": { "d1": { "Address": "http://localhost:5006/" } } }
    }
  }
}