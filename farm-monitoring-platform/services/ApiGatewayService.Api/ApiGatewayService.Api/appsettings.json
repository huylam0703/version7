{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "AUTH_JWKS_URI": "http://localhost:8081/.well-known/jwks.json",

  "Gateway": {
    "Auth": { "Enabled": true },
    "Cors": { "Origins": [ "http://localhost:3000", "http://localhost:5173" ] },
    "RateLimit": { "PermitPerMinute": 120 }
  },

  "ReverseProxy": {
    "Routes": {
      "auth-anonymous": {
        "ClusterId": "user-auth",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/v1/auth/{action:regex(^(login|refresh)$)}" }
      },
      "auth-secured": {
        "ClusterId": "user-auth",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/auth/{**rest}" }
      },
      "users": {
        "ClusterId": "user-auth",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/{resource:regex(^(users|roles)$)}/{**rest}" }
      },
      "farm-device": {
        "ClusterId": "farm-device",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/{resource:regex(^(farms|zones|nodes|uavs|gateways|sensor-types)$)}/{**rest}" }
      },
      "missions": {
        "ClusterId": "mission",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/missions/{**rest}" }
      },
      "sensor-data": {
        "ClusterId": "sensor-data",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/{resource:regex(^(readings|sync-batches)$)}/{**rest}" }
      },
      "alerts": {
        "ClusterId": "alert",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/{resource:regex(^(alerts|thresholds)$)}/{**rest}" }
      },
      "notifications": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/notifications/{**rest}" }
      }
    },
    "Clusters": {
      "user-auth": { "Destinations": { "d1": { "Address": "http://localhost:8081/" } } },
      "farm-device": { "Destinations": { "d1": { "Address": "http://localhost:8082/" } } },
      "mission": { "Destinations": { "d1": { "Address": "http://localhost:8083/" } } },
      "sensor-data": { "Destinations": { "d1": { "Address": "http://localhost:8084/" } } },
      "alert": { "Destinations": { "d1": { "Address": "http://localhost:8085/" } } },
      "notification": { "Destinations": { "d1": { "Address": "http://localhost:8086/" } } }
    }
  }
}