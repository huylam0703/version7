{
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "user-auth",
        "Match": { "Path": "/api/v1/auth/{**rest}" }
      },
      "users": {
        "ClusterId": "user-auth",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/users/{**rest}" }
      },
      "farms": {
        "ClusterId": "farm-device",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/farms/{**rest}" }
      },
      "missions": {
        "ClusterId": "mission",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/missions/{**rest}" }
      },
      "alerts": {
        "ClusterId": "alert",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/alerts/{**rest}" }
      },
      "notifs": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/v1/notifications/{**rest}" }
      }
    },
    "Clusters": {
      "user-auth": { "Destinations": { "d1": { "Address": "http://user-auth-service:8080/" } } },
      "farm-device": { "Destinations": { "d1": { "Address": "http://farm-device-service:8080/" } } }
    }
  }
}