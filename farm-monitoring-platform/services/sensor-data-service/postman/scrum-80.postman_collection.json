    {
      "name": "Statistics keep ADC and centimetres separate",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/readings/statistics?nodeId={{nodeId}}&sensorType=WATER_LEVEL"
      },
      "event": [
        {
