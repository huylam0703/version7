<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vn.farm.platform</groupId>
    <artifactId>farm-platform-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>farm-contracts</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <version>2.2.30</version>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.6</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.14.0</version>
        <executions>
          <execution>
            <id>farm-device</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/../../../contracts/openapi/farm-device.v1.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>vn.farm.contracts.farmdevice.api</apiPackage>
              <modelPackage>vn.farm.contracts.farmdevice.model</modelPackage>
              <generateSupportingFiles>true</generateSupportingFiles>
              <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>true</useTags>
                <openApiNullable>false</openApiNullable>
              </configOptions>
            </configuration>
          </execution>

          <execution>
            <id>event-readings-synced</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/../../../contracts/events/readings.synced.v1.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <modelPackage>vn.farm.contracts.events.readingssynced</modelPackage>
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <useSpringBoot3>true</useSpringBoot3>
                <openApiNullable>false</openApiNullable>
              </configOptions>
            </configuration>
          </execution>

          <execution>
            <id>event-node-state-updated</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/../../../contracts/events/node.state_updated.v1.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <modelPackage>vn.farm.contracts.events.nodestateupdated</modelPackage>
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <useSpringBoot3>true</useSpringBoot3>
                <openApiNullable>false</openApiNullable>
              </configOptions>
            </configuration>
          </execution>

          <execution>
            <id>event-batch-synced</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/../../../contracts/events/batch.synced.v1.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <modelPackage>vn.farm.contracts.events.batchsynced</modelPackage>
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <useSpringBoot3>true</useSpringBoot3>
                <openApiNullable>false</openApiNullable>
              </configOptions>
            </configuration>
          </execution>

          <execution>
            <id>event-mission-status-changed</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/../../../contracts/events/mission.status_changed.v1.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <modelPackage>vn.farm.contracts.events.missionstatuschanged</modelPackage>
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <useSpringBoot3>true</useSpringBoot3>
                <openApiNullable>false</openApiNullable>
              </configOptions>
            </configuration>
          </execution>

          <execution>
            <id>event-alert-created</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <inputSpec>${project.basedir}/../../../contracts/events/alert.created.v1.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <modelPackage>vn.farm.contracts.events.alertcreated</modelPackage>
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <configOptions>
                <useSpringBoot3>true</useSpringBoot3>
                <openApiNullable>false</openApiNullable>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>